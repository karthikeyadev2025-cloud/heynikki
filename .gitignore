# Environment files - NEVER commit these
.env
.env.local
.env.production
.env.*.local
*.env

# Node
node_modules/
.next/
dist/
build/
.turbo/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
*.g.dart
*.freezed.dart

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Logs
*.log
logs/

# Test outputs
test_tts_output.wav

# Flutter Android signing — NEVER commit
flutter-app/android/key.properties
flutter-app/android/*.jks
flutter-app/android/*.keystore

# SSH keys - NEVER commit
*.pem
*.key

# SSH keys - NEVER commit
*.pem
*.key

# TypeScript / Next build caches (regenerated on every build)
*.tsbuildinfo
next-env.d.ts

# FreeSWITCH auto-generates TLS key material here at runtime (root-owned,
# container-created). Never commit private keys.
infra/freeswitch/conf/tls/

# Host-specific compose overrides (e.g. disabling nginx on the on-prem
# telephony box, where it has no certs and proxies nothing). Must never
# be committed — docker-compose.yml is shared with the EC2 frontend.
docker-compose.override.yml
**/docker-compose.override.yml
