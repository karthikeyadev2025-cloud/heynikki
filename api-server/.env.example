# api-server environment variables
# Copy to .env and fill in real values. NEVER commit .env.

# ── Supabase ──
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# ── Razorpay (billing) ──
RAZORPAY_KEY_ID=rzp_live_your_key
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
# Set after running scripts/setup_razorpay_plans.ts:
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_SCALE=

# ── WhatsApp (Wati) ──
WATI_API_KEY=your_wati_key
WATI_API_URL=https://live-mt-server.wati.io/YOUR_ACCOUNT

# ── Exotel webhook token (shared secret in URL path) ──
# Generate with: openssl rand -hex 24
# Configure Exotel webhook URL as:
#   https://api.heynikki.in/webhooks/exotel/inbound/<this-value>
#   https://api.heynikki.in/webhooks/exotel/status/<this-value>
EXOTEL_WEBHOOK_TOKEN=replace-with-openssl-rand-hex-24

# ── TRAI DND / NCPR scrubbing ──
# UNSET BY DEFAULT, AND THAT IS DELIBERATE: with no provider, any number
# without recorded consent is BLOCKED rather than dialled. Bulk campaigns
# therefore do not run until a real registry is wired. That is the safe
# failure, not a bug to work around by faking a provider.
#
# India's NCPR is not a public API. It is reached through a DLT platform
# (Jio TrueConnect, Airtel IQ, Vi, BSNL, Tata Vilpower) after registering
# as a principal entity / telemarketer. Each platform's API differs, so
# wiring one means implementing queryProvider() in src/dnd.ts — the rest of
# the path (opt-out list, consent carve-out, caching, audit ledger,
# fail-safe) is already built and tested.
#
# If your provider already speaks the generic REST shape
#   GET {URL}/check?phone=91XXXXXXXXXX   ->   { "on_dnd": bool, "reason": str }
#   Authorization: Bearer {TOKEN}
# then setting these three is enough and no code changes are needed.
DND_SCRUB_PROVIDER_URL=
DND_SCRUB_PROVIDER_TOKEN=
DND_SCRUB_PROVIDER_NAME=
# How long a provider answer may be reused, in hours. Default 24, hard
# ceiling 7 days (enforced by a CHECK constraint in migration 050). Shorter
# is safer: a customer who registers for DND today should stop receiving
# calls quickly.
DND_SCRUB_TTL_HOURS=24

# ── Internal service-to-service auth ──
INTERNAL_SECRET=change-this-to-random-string

# ── Voice pipeline ──
PIPELINE_URL=https://pipeline.heynikki.in

# ── Email (Resend) ──
RESEND_API_KEY=re_your_resend_key
FROM_EMAIL=noreply@heynikki.in

PORT=4000

# ── Sentry (optional, leave blank to disable) ──
# Get from: https://sentry.io → Projects → heynikki-api → Client Keys (DSN)
SENTRY_DSN=
NODE_ENV=production
RELEASE_SHA=
