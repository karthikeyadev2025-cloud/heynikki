# ─────────────────────────────────────────────────────────────
# Hey Nikki voice pipeline — environment variables
# Copy these into Railway → your service → Variables.
# NEVER commit real values. This file is a template only.
# ─────────────────────────────────────────────────────────────

# ── REQUIRED: the app won't start/work without these ──

# Sarvam (Telugu/Hindi STT + TTS)
SARVAM_API_KEY=

# Gemini (the LLM brain + appointment extraction)
GEMINI_API_KEY=

# Supabase (database + call logging + recordings)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_RECORDINGS_BUCKET=recordings

# Call-recording encryption key — AES-256-GCM, base64 of exactly 32 bytes.
# FRESH START: generate a NEW one locally and paste the output:
#   python3 -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Keep it safe. Recordings encrypted with it can't be decrypted without it.
HEYNIKKI_RECORDING_KEY=

# ── EXOTEL: needed for phone calls ──
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
EXOTEL_SUBDOMAIN=api.in.exotel.com
# Only needed once you enable outbound campaigns:
EXOTEL_OUTBOUND_APP_ID=

# ── VOICE TUNING (optional — sensible defaults if unset) ──
TTS_TEMPERATURE=0.85
TTS_PACE=1.1

# ── WHATSAPP (optional — dormant until all 3 are set) ──
# Leave blank until your Meta template is approved. Code no-ops safely when
# empty; appointments still save, just no WhatsApp message goes out.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_CONFIRM_TEMPLATE=appointment_confirmation
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v21.0

# ── RAILWAY sets PORT automatically — do NOT set it yourself ──
