# ============================================================
# HEYNIKKI Voice Pipeline — EC2 Environment Template
# Copy this to .env on your EC2 instance and fill real values
# Get values from your local .env file
# NEVER commit .env to git
# ============================================================

SUPABASE_URL=https://wnawozdmmxuziucavngw.supabase.co
SUPABASE_SERVICE_KEY=<your_supabase_service_role_key>

SARVAM_API_KEY=<your_sarvam_api_key>
GEMINI_API_KEY=<your_gemini_api_key>

LIVEKIT_URL=wss://heynikki-7xgvqaga.livekit.cloud
LIVEKIT_API_KEY=<your_livekit_api_key>
LIVEKIT_API_SECRET=<your_livekit_api_secret>

# REQUIRED — the pipeline refuses to start without it, by design.
# Generate with: openssl rand -hex 32
# Must be the SAME value on the api-server, scheduler and dispatcher.
# This file used to ship a working default here, which was a third
# candidate secret alongside the one hardcoded in main.py.
INTERNAL_SECRET=<generate_with_openssl_rand_hex_32>

EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=

WATI_API_KEY=
WATI_API_URL=

GOOGLE_STT_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
OPENAI_API_KEY=
