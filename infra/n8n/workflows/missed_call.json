{
  "name": "Hey Nikki — Missed Call WhatsApp Follow-up",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "missed-call",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "trigger-missed-call",
      "name": "Webhook — Missed Call",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "webhookId": "ce060304-b55a-5652-892f-18a0c5046187"
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "caller_number",
              "value": "={{ $json.body.caller_number }}"
            },
            {
              "name": "business_name",
              "value": "={{ $json.body.business_name }}"
            },
            {
              "name": "tenant_id",
              "value": "={{ $json.body.tenant_id }}"
            },
            {
              "name": "call_id",
              "value": "={{ $json.body.call_id }}"
            },
            {
              "name": "wa_number",
              "value": "={{ $json.body.whatsapp_number || $json.body.caller_number }}"
            }
          ]
        },
        "options": {}
      },
      "id": "set-vars",
      "name": "Extract Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WATI_API_URL }}/api/v1/sendTemplateMessage?whatsappNumber={{ $node['Extract Fields'].json.wa_number }}",
        "authentication": "none",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.WATI_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"template_name\": \"missed_call_followup\",\n  \"broadcast_name\": \"missed_call_{{ $node['Extract Fields'].json.call_id }}\",\n  \"parameters\": [\n    {\n      \"name\": \"business_name\",\n      \"value\": \"{{ $node['Extract Fields'].json.business_name }}\"\n    }\n  ]\n}"
      },
      "id": "send-wa",
      "name": "Send WhatsApp — Missed Call Template",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/wa_dispatch_log",
        "authentication": "none",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"tenant_id\": \"{{ $node['Extract Fields'].json.tenant_id }}\",\n  \"call_id\": \"{{ $node['Extract Fields'].json.call_id }}\",\n  \"message_type\": \"missed_call\",\n  \"to_number\": \"{{ $node['Extract Fields'].json.wa_number }}\",\n  \"message_body\": \"Missed call follow-up sent via n8n\",\n  \"status\": \"sent\",\n  \"provider_msg_id\": \"{{ $node['Send WhatsApp — Missed Call Template'].json.id || '' }}\"\n}"
      },
      "id": "log-supabase",
      "name": "Log to Supabase wa_dispatch_log",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"ok\": true}"
      },
      "id": "respond",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1120,
        300
      ],
      "webhookId": "899bebe6-a07f-5263-a690-e5c46baa03dc"
    }
  ],
  "connections": {
    "Webhook — Missed Call": {
      "main": [
        [
          {
            "node": "Extract Fields",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Fields": {
      "main": [
        [
          {
            "node": "Send WhatsApp — Missed Call Template",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send WhatsApp — Missed Call Template": {
      "main": [
        [
          {
            "node": "Log to Supabase wa_dispatch_log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log to Supabase wa_dispatch_log": {
      "main": [
        [
          {
            "node": "Respond OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "heynikki-wati-missed-call"
}