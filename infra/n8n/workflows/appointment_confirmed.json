{
  "name": "Hey Nikki — Appointment Confirmation & 24h Reminder",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "appointment-confirmed",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "trigger-missed-call",
      "name": "Webhook — Missed Call",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "caller_number",
              "value": "={{ $json.body.caller_number }}"
            },
            {
              "name": "business_name",
              "value": "={{ $json.body.business_name }}"
            },
            {
              "name": "tenant_id",
              "value": "={{ $json.body.tenant_id }}"
            },
            {
              "name": "call_id",
              "value": "={{ $json.body.call_id }}"
            },
            {
              "name": "wa_number",
              "value": "={{ $json.body.whatsapp_number || $json.body.caller_number }}"
            },
            {
              "name": "service",
              "value": "={{ $json.body.service }}"
            },
            {
              "name": "slot_date",
              "value": "={{ $json.body.slot_date }}"
            },
            {
              "name": "slot_time",
              "value": "={{ $json.body.slot_time }}"
            },
            {
              "name": "appointment_id",
              "value": "={{ $json.body.appointment_id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "set-vars",
      "name": "Extract Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WATI_API_URL }}/api/v1/sendTemplateMessage?whatsappNumber={{ $node['Extract Fields'].json.wa_number }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headers": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.WATI_API_KEY }}"
            }
          ]
        },
        "bodyParameters": {
          "parameters": []
        },
        "body": {
          "contentType": "json",
          "body": "={\n  \"template_name\": \"appointment_confirmed\",\n  \"broadcast_name\": \"appt_{{ $node['Extract Fields'].json.call_id }}\",\n  \"parameters\": [\n    {\n      \"name\": \"business_name\",\n      \"value\": \"{{ $node['Extract Fields'].json.business_name }}\"\n    },\n    {\n      \"name\": \"service\",\n      \"value\": \"{{ $node['Extract Fields'].json.service }}\"\n    },\n    {\n      \"name\": \"slot_date\",\n      \"value\": \"{{ $node['Extract Fields'].json.slot_date }}\"\n    },\n    {\n      \"name\": \"slot_time\",\n      \"value\": \"{{ $node['Extract Fields'].json.slot_time }}\"\n    },\n    {\n      \"name\": \"appointment_id\",\n      \"value\": \"{{ $node['Extract Fields'].json.appointment_id }}\"\n    }\n  ]\n}"
        },
        "options": {}
      },
      "id": "send-wa",
      "name": "Send WhatsApp — Appointment Confirmation & 24h Reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/wa_dispatch_log",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headers": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "body": {
          "contentType": "json",
          "body": "={\n  \"tenant_id\": \"{{ $node['Extract Fields'].json.tenant_id }}\",\n  \"call_id\": \"{{ $node['Extract Fields'].json.call_id }}\",\n  \"message_type\": \"appointment_confirm\",\n  \"to_number\": \"{{ $node['Extract Fields'].json.wa_number }}\",\n  \"message_body\": \"Missed call follow-up sent via n8n\",\n  \"status\": \"sent\",\n  \"provider_msg_id\": \"{{ $node['Send WhatsApp — Missed Call Template'].json.id || '' }}\"\n}"
        },
        "options": {}
      },
      "id": "log-supabase",
      "name": "Log to Supabase wa_dispatch_log",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"ok\": true}"
      },
      "id": "respond",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1120,
        300
      ]
    }
  ],
  "connections": {
    "Webhook — Missed Call": {
      "main": [
        [
          {
            "node": "Extract Fields",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Fields": {
      "main": [
        [
          {
            "node": "Send WhatsApp — Missed Call Template",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send WhatsApp — Missed Call Template": {
      "main": [
        [
          {
            "node": "Log to Supabase wa_dispatch_log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log to Supabase wa_dispatch_log": {
      "main": [
        [
          {
            "node": "Respond OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    "heynikki",
    "missed-call",
    "whatsapp"
  ]
}