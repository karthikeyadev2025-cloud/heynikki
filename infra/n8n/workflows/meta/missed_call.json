{
  "name": "Hey Nikki — Missed Call WhatsApp Follow-up (Meta Cloud API)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "missed-call",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "trigger-missed-call",
      "name": "Webhook — Missed Call",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "webhookId": "bef8ccb0-7f9b-54e8-9357-aae552e33e51"
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "caller_number",
              "value": "={{ $json.body.caller_number }}"
            },
            {
              "name": "business_name",
              "value": "={{ $json.body.business_name }}"
            },
            {
              "name": "tenant_id",
              "value": "={{ $json.body.tenant_id }}"
            },
            {
              "name": "call_id",
              "value": "={{ $json.body.call_id }}"
            },
            {
              "name": "wa_number",
              "value": "={{ $json.body.whatsapp_number || $json.body.caller_number }}"
            }
          ]
        },
        "options": {}
      },
      "id": "set-vars",
      "name": "Extract Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $node['Lookup Sender'].json.phone_number_id || $env.META_WA_PHONE_NUMBER_ID }}/messages",
        "authentication": "none",
        "options": {},
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.META_WA_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendHeaders": true,
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $node['Extract Fields'].json.wa_number }}\",\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"missed_call_followup\",\n    \"language\": {\n      \"code\": \"en\"\n    },\n    \"components\": [\n      {\n        \"type\": \"body\",\n        \"parameters\": [\n          {\n            \"type\": \"text\",\n            \"text\": \"{{ $node['Extract Fields'].json.business_name }}\"\n          }\n        ]\n      }\n    ]\n  }\n}"
      },
      "id": "send-wa",
      "name": "Send WhatsApp — Missed Call Template",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/wa_dispatch_log",
        "authentication": "none",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"tenant_id\": \"{{ $node['Extract Fields'].json.tenant_id }}\",\n  \"call_id\": {{ JSON.stringify($node['Extract Fields'].json.call_id || null) }},\n  \"message_type\": \"missed_call\",\n  \"to_number\": \"{{ $node['Extract Fields'].json.wa_number }}\",\n  \"message_body\": \"template:missed_call_followup\",\n  \"status\": \"sent\",\n  \"provider_msg_id\": \"{{ $node['Send WhatsApp — Missed Call Template'].json.messages?.[0]?.id || '' }}\"\n}"
      },
      "id": "log-supabase",
      "name": "Log to Supabase wa_dispatch_log",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"ok\": true}"
      },
      "id": "respond",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1340,
        300
      ],
      "webhookId": "73074230-b3e0-5c20-bebb-4d47299f8e7b"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/tenant_whatsapp?select=phone_number_id&status=eq.active&tenant_id=eq.{{ $node['Extract Fields'].json.tenant_id }}",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Lookup Sender",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        680,
        300
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "notes": "The business's own WhatsApp sender (tenant_whatsapp, status active). None = the platform number."
    }
  ],
  "connections": {
    "Webhook — Missed Call": {
      "main": [
        [
          {
            "node": "Extract Fields",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Fields": {
      "main": [
        [
          {
            "node": "Lookup Sender",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send WhatsApp — Missed Call Template": {
      "main": [
        [
          {
            "node": "Log to Supabase wa_dispatch_log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log to Supabase wa_dispatch_log": {
      "main": [
        [
          {
            "node": "Respond OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Lookup Sender": {
      "main": [
        [
          {
            "node": "Send WhatsApp — Missed Call Template",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "heynikki-meta-missed-call"
}
