# ================================================================
# Hey Nikki v4.0 — Complete Environment Variables
# Copy this to .env and fill in all values before running docker compose
# ================================================================

# ── Supabase ────────────────────────────────────────────────────
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_ENCRYPTION_KEY=your-32-char-random-string-here

# ── AI Providers ────────────────────────────────────────────────
SARVAM_API_KEY=
GEMINI_API_KEY=
# gemini-2.5-flash is retired ("no longer supported"). Measured best for
# live Telugu turns: 0.86s p50 / 1.04s p95 TTFT. See main.py GeminiLLM.
GEMINI_MODEL=gemini-3.5-flash-lite

# ── FreeSWITCH ESL ──────────────────────────────────────────────
# 127.0.0.1 is correct here — api-server runs with network_mode: host
# in docker-compose.yml (matching freeswitch itself), so this container
# genuinely shares the host's loopback rather than having its own
# separate one. FreeSWITCH's ESL is intentionally bound to 127.0.0.1
# only (see event_socket.conf.xml) for security — a bridged container
# reaching in via host.docker.internal would NOT work here, since that
# resolves to the Docker bridge gateway IP, a different interface than
# true loopback, which a loopback-only bind refuses.
FREESWITCH_HOST=127.0.0.1
FREESWITCH_ESL_PORT=8021
# REQUIRED — generate a strong one: openssl rand -hex 24
# "ClueCon" is FreeSWITCH's stock password and every scanner knows it.
# ESL has full call control, so a weak value here is a live takeover risk.
# The code no longer falls back to a default; unset means ESL refuses.
FREESWITCH_ESL_PASSWORD=

# ── Jio Enterprise SIP Trunk (circuit-delivered, IP-authenticated) ──
# Circuit SIP_9188875079_8633502031 — 10 channels
# Jio supplied NO username/password: the circuit is the credential and
# their SBC authorises us by source IP. Nothing secret goes here.
#
# This host must sit ON the Jio circuit. Every address below is inside
# RFC 6598 CGNAT space (100.64.0.0/10) and is NOT reachable from the
# public internet — an EC2 instance cannot hold 100.65.188.4.
JIO_LOCAL_IP=100.65.188.4          # our SIP/RTP bind address on the circuit
JIO_GATEWAY_IP=100.65.188.1        # circuit gateway (default route for SIP)
JIO_SBC_IP=100.64.0.4              # Jio signalling
JIO_MEDIA_IP=100.64.0.6            # Jio RTP
JIO_DID_FIRST=8633502031
JIO_DID_LAST=8633502064

# ── Vi Business SIP Trunk (Failover) ────────────────────────────
# Get these from Vi Business portal or Vi enterprise account manager
VI_SIP_HOST=sip.vibusiness.in
VI_SIP_USERNAME=
VI_SIP_PASSWORD=

# ── Cloudflare R2 (Free recording storage) ──────────────────────
# Create R2 bucket at: dash.cloudflare.com → R2 → Create bucket
CF_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=heynikki-recordings
R2_PUBLIC_URL=https://pub-XXXX.r2.dev

# ── Exotel (Toggle fallback — only needed if telephony_engine = exotel) ──
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SID=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_WEBHOOK_TOKEN=

# ── WhatsApp (via Wati.io) ───────────────────────────────────────
WATI_API_KEY=
WATI_API_URL=https://live-mt-server.wati.io/XXXXX

# ── n8n (self-hosted on EC2) ─────────────────────────────────────
N8N_PASSWORD=changeme-strong-password
N8N_ENCRYPTION_KEY=your-32-char-random-string
N8N_HOST=n8n.heynikki.in
N8N_WEBHOOK_BASE=https://n8n.heynikki.in/webhook

# ── Activepieces (self-hosted on EC2) ───────────────────────────
ACTIVEPIECES_ENCRYPTION_KEY=your-32-char-random-string
ACTIVEPIECES_JWT_SECRET=your-32-char-random-string
ACTIVEPIECES_WEBHOOK_BASE=https://activepieces.heynikki.in/api/v1/webhooks

# ── API Server ───────────────────────────────────────────────────
PORT=4000
INTERNAL_SECRET=your-very-long-random-internal-secret
PIPELINE_URL=http://voice-pipeline:8000

# ── Payments (Razorpay) ─────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Monitoring ───────────────────────────────────────────────────
SENTRY_DSN=

# ── Next.js Public Vars (for Vercel deploys) ────────────────────
# Add these to Vercel environment variables
NEXT_PUBLIC_SUPABASE_URL=https://XXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_API_URL=https://api.heynikki.in

# ── WhatsApp provider ───────────────────────────────────────────
# "wati" = Wati reseller (monthly fee per account, on top of Meta's
#          per-conversation charges). Fine for one business.
# "meta" = Meta Cloud API direct. No middleman fee, and it supports
#          Embedded Signup so each tenant can connect their OWN number
#          programmatically — which is what a multi-tenant platform
#          actually needs. Requires a verified Meta Business account.
WHATSAPP_PROVIDER=meta

# Meta Cloud API (WHATSAPP_PROVIDER=meta)
# Phone Number ID comes from Meta Business Suite -> WhatsApp -> API Setup.
# It is NOT the phone number itself — it's a numeric ID.
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_API_VERSION=v21.0

# Wati (WHATSAPP_PROVIDER=wati) — kept as fallback
WATI_API_KEY=
WATI_API_URL=
