<!--
  Hey Nikki SIP profile — binds to port 5060 and loads the Jio/Vi
  trunk gateways from heynikki_trunks.xml. This is the piece that was
  missing: heynikki_trunks.xml only defines <gateway> blocks, which
  mod_sofia never loads unless a <profile> includes them.
-->
<include>
  <profile name="heynikki">
    <gateways>
      <X-PRE-PROCESS cmd="include" data="heynikki_trunks.xml"/>
    </gateways>

    <settings>
      <param name="context"                value="heynikki"/>
      <param name="sip-port"                value="5060"/>
      <!-- Bind explicitly to the Jio circuit interface (100.65.188.4).
           $${local_ip_v4} picks whichever interface FreeSWITCH finds
           first, and this host is dual-homed: the Jio circuit for SIP,
           and separate broadband for the AI APIs. Guessing wrong means
           SIP goes out of the internet NIC and Jio never sees it. -->
      <param name="rtp-ip"                  value="$${JIO_LOCAL_IP}"/>
      <param name="sip-ip"                  value="$${JIO_LOCAL_IP}"/>

      <!-- NO ext-sip-ip / ext-rtp-ip.
           Those exist for a box behind NAT advertising a different
           public address in its SDP. On a delivered circuit we speak
           to Jio's SBC directly from 100.65.188.4 with no NAT between
           us, so advertising anything else puts an unreachable address
           in the SDP and the call connects with one-way or no audio. -->

      <param name="auth-calls"              value="false"/>
      <!-- Trunk-only profile: Jio/Vi are the only peers, authenticated
           via the gateway register above, not inbound challenge — so
           auth-calls stays false and access is restricted at the
           network layer instead. -->
      <!-- ACTIVE: acl.conf.xml now carries Jio's real SBC/media hosts. -->
      <param name="apply-inbound-acl"       value="heynikki-sip-trunks"/>

      <param name="codec-prefs"             value="PCMU,PCMA"/>
      <param name="inbound-codec-negotiation" value="generous"/>
      <param name="dtmf-type"               value="rfc2833"/>
      <!-- media_timeout/media_hold_timeout supersede rtp-timeout-sec and
           rtp-hold-timeout-sec, which log a deprecation warning on every
           profile load. NOTE THE UNITS: the old params were SECONDS, these
           are MILLISECONDS — copying 300 across verbatim would tear calls
           down after 300ms. -->
      <variables>
        <variable name="media_timeout"      value="300000" direction="inbound"/>
        <variable name="media_hold_timeout" value="1800000" direction="inbound"/>
      </variables>
      <param name="disable-register"        value="false"/>
      <param name="apply-nat-acl"           value="nat.auto"/>
    </settings>
  </profile>
</include>
