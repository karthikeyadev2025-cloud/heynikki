<configuration name="modules.conf" description="Modules">
  <modules>
    <!-- Logging -->
    <load module="mod_console"/>
    <load module="mod_logfile"/>

    <!-- Core dialplan + call control -->
    <load module="mod_sofia"/>
    <load module="mod_dialplan_xml"/>
    <load module="mod_dptools"/>
    <load module="mod_commands"/>

    <!-- ESL — api-server's esl.ts connects here (Click-to-Call, channel status) -->
    <load module="mod_event_socket"/>

    <!-- File I/O — record_session (call recording), speak/TTS fallback -->
    <load module="mod_sndfile"/>
    <load module="mod_native_file"/>
    <load module="mod_flite"/>

    <!-- Streams audio to the voice-pipeline WebSocket. Third-party module —
         built into the freeswitch image via infra/freeswitch/Dockerfile,
         NOT part of stock FreeSWITCH. If calls fail with
         "no application audio_stream", this module failed to build/load —
         check `fs_cli -x "module_exists mod_audio_stream"`. -->
    <load module="mod_audio_stream"/>

    <!-- Codecs: PCMU/PCMA (G.711) are core and always available -->
  </modules>
</configuration>
