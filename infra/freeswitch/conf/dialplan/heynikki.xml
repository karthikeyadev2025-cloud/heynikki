<!-- ================================================================
  Hey Nikki — FreeSWITCH Dialplan
  Context: heynikki
  Handles: Inbound from Jio/Vi, Human ring group, Missed Call Guard,
           Click-to-Call, Outbound campaigns
  ================================================================ -->
<include>
  <context name="heynikki">

    <!-- ============================================================
      ROUTING DESIGN NOTE

      The dids table has a routing_mode column (ai|human|hybrid|ivr)
      and Super Admin shows it, but nothing enforced it — every inbound
      call went to the AI regardless of the setting.

      The routing decision is NOT made here in XML. mod_curl is not in
      modules.conf.xml, so a ${curl(...)} lookup in the dialplan would
      fail silently at runtime and take every inbound call with it.
      Instead the voice pipeline makes the call: it already looks the
      DID up on WebSocket connect, so when routing_mode is "human" it
      asks the API server to uuid_transfer this channel into the
      human_ ring-group extension below and closes the socket.

      That keeps one DID lookup, one source of truth, and needs no
      module that isn't already loaded.

      TRAI COMPLIANCE: AI-handled calls must disclose their automated
      nature within the first 5 seconds (TCCCPR-2018, amended 2023).
      ============================================================ -->

    <!-- ══════════════════════════════════════════════════════════
      DID NORMALISATION — runs first, on every inbound call.

      Jio does NOT send one consistent format. Observed on the live
      trunk, both from the same DID:
          08633502031      national, leading zero
          +918633502031    E.164

      The old inbound extension matched "^(\+?91\d{10}|\d{10})$",
      which accepts +91… and bare 10-digit but NOT the leading-zero
      form — 08633502031 is eleven digits and matches neither branch.
      Every call arriving in that format fell straight through to the
      catch-all and was answered with a 404. The caller hears the line
      reject them and nothing is logged as a call at all, so the
      failure is invisible from the dashboard.

      These three extensions strip whatever prefix arrived and leave a
      canonical 10-digit did_number for everything downstream. They use
      continue="true" so routing carries on to the real extension, and
      inline="true" so the variable is set DURING routing and is
      therefore visible to the conditions below (a plain set executes
      after routing completes and would be too late).

      Order matters: +91/91 first, then leading zero, then bare — so
      918633502031 is read as a country code rather than as a
      ten-digit number with junk on the end.
      ══════════════════════════════════════════════════════════ -->
    <extension name="normalize_did_e164" continue="true">
      <condition field="destination_number" expression="^\+?91(\d{10})$">
        <action application="set" data="did_number=$1" inline="true"/>
      </condition>
    </extension>

    <extension name="normalize_did_national" continue="true">
      <condition field="destination_number" expression="^0(\d{10})$">
        <action application="set" data="did_number=$1" inline="true"/>
      </condition>
    </extension>

    <extension name="normalize_did_local" continue="true">
      <condition field="destination_number" expression="^(\d{10})$">
        <action application="set" data="did_number=$1" inline="true"/>
      </condition>
    </extension>

    <!-- Caller ID arrives with the same inconsistency. Normalising it
         too means a repeat caller matches the SAME lead row whether
         this call came in as 0xxxxxxxxxx or +91xxxxxxxxxx — otherwise
         one human becomes two leads and their history splits. -->
    <extension name="normalize_caller" continue="true">
      <condition field="caller_id_number" expression="^\+?91(\d{10})$">
        <action application="set" data="caller_ani=$1" inline="true"/>
        <anti-action application="set" data="caller_ani=${caller_id_number}" inline="true"/>
      </condition>
    </extension>

    <extension name="normalize_caller_national" continue="true">
      <condition field="caller_ani" expression="^0(\d{10})$">
        <action application="set" data="caller_ani=$1" inline="true"/>
      </condition>
    </extension>

    <!-- ── INBOUND FROM JIO / VI SIP TRUNK ────────────────────── -->
    <extension name="inbound_sip_ai" continue="false">
      <!-- Conditions AND together. This first one is a guard, not a match:
           did_number is a CHANNEL VARIABLE and survives uuid_transfer, so
           when esl.ts transfers a live call to "human_transfer" the dialplan
           re-runs from the top with did_number still set to the 10-digit DID.
           Without this guard the condition below matched again and
           continue="false" stopped routing here — inbound_human and
           missed_call_guard were unreachable, every routing_mode=human DID
           silently got the AI a second time (new audio stream, duplicate
           hangup hook, no record_session), and the caller heard the bot
           restart from its greeting. Nothing errored, so it was invisible.
           Requiring the DIALLED string to look like a phone number keeps
           human_/missed_/ctc_/out_/camp_ destinations out of this extension. -->
      <condition field="destination_number" expression="^(?:\+?91|0)?\d{10}$"/>
      <!-- Keys off the normalised did_number, not the raw dialled
           string, so every prefix format Jio sends lands here. -->
      <condition field="${did_number}" expression="^\d{10}$">

        <action application="set" data="hangup_after_bridge=true"/>
        <action application="set" data="continue_on_fail=false"/>
        <action application="set" data="call_timeout=120"/>

        <action application="answer"/>

        <!-- TRAI AI disclosure (mandatory, within 5 seconds) -->
        <!-- Uncomment when the audio file is in place:
        <action application="playback" data="/etc/freeswitch/sounds/trai_disclosure.wav"/>
        -->

        <!-- NOTE: deliberately no record_session on this leg.
             The voice pipeline accumulates the same inbound PCM in
             memory and uploads it to Cloudflare R2 on hangup. Recording
             here as well wrote a SECOND copy of every call to
             /tmp/recordings, and nothing ever deleted it — so the EC2
             disk filled over time and took FreeSWITCH, the pipeline and
             the API server down together. R2 is the single source of
             truth for AI-handled calls. Human-mode calls DO record
             here, since no pipeline sits in that path. -->

        <action application="set" data="STREAM_MESSAGE_DEFLECTION=false"/>
        <!-- 100ms, not 320. The VAD can only decide on frame boundaries, so the
             frame size is its granularity: at 520ms frames the 0.60s silence
             target rounded to ONE frame and 520ms became the floor. 100ms
             frames let the pipeline wait 0.40s and act on it promptly.
             Must be a multiple of 20ms or the module silently falls back to
             20ms ("Buffer size of %s is not a multiple of 20ms"). -->
        <action application="set" data="STREAM_BUFFER_SIZE=100"/>
        <!-- Armed BEFORE park on purpose. park blocks until the caller
             hangs up and the dialplan does NOT resume afterwards, so an
             action placed after it never runs. `expand` defers the
             variable expansion to hook time — billsec and hangup_cause
             are both empty while the call is still up, which is why the
             backslashes are there.

             api_reporting_hook, NOT api_hangup_hook: the hangup hook runs
             during CS_HANGUP, before the CDR variables are computed, so
             billsec arrived as 0 and hangup_cause empty. A 22s call that
             ended NORMAL_CLEARING was therefore misfiled as a missed call
             by the <5s check in api-server's /webhooks/freeswitch/hangup.
             CS_REPORTING runs after the CDR is finalised. -->
        <!-- Without these two, FreeSWITCH invokes the hook API with a NULL
             session, so `expand` has no channel and every ${...} resolves
             to empty. That produced "duration":, — invalid JSON — and
             express rejected the POST with 400 entity.parse.failed before
             the handler ever ran. duration is also quoted below so a failed
             expansion degrades to 0 rather than breaking the payload. -->
        <action application="set" data="process_cdr=true"/>
        <action application="set" data="session_in_hangup_hook=true"/>
        <action application="set" data="api_reporting_hook=expand uuid:${uuid} system curl -s -X POST http://127.0.0.1:4000/webhooks/freeswitch/hangup -H 'Content-Type: application/json' -H 'X-Internal-Secret: ${INTERNAL_SECRET}' -d '{&quot;fs_uuid&quot;:&quot;${uuid}&quot;,&quot;duration&quot;:&quot;\${billsec}&quot;,&quot;hangup_cause&quot;:&quot;\${hangup_cause}&quot;,&quot;did_number&quot;:&quot;${did_number}&quot;,&quot;caller_number&quot;:&quot;${caller_ani}&quot;}' &amp;"/>

        <!-- mod_audio_stream registers uuid_audio_stream as an API, NOT an
             application — there is no `audio_stream` app, so the old
             <action application="audio_stream"> could never have worked.
             Signature: <uuid> start <ws-url> <mono|mixed|stereo> <8000|16000>
             8000 matches G.711 on the trunk and the pipeline's
             sampleRateHertz. The API returns immediately, so park holds
             the leg open while the pipeline drives it over the socket. -->
        <action application="set" data="stream_result=${uuid_audio_stream(${uuid} start ws://127.0.0.1:8000/ws/freeswitch/${did_number}/${caller_ani}/${uuid} mono 8000)}"/>
        <action application="park"/>

      </condition>
    </extension>

    <!-- ── HUMAN MODE — ring the tenant's telecallers ──────────
      Reached by ESL uuid_transfer from the API server when the DID's
      routing_mode is "human" (or hybrid escalates mid-call).
      Destination carries the ring-group members and the guard timeout
      as channel variables set by the transferring ESL command.
      ============================================================ -->
    <extension name="inbound_human" continue="false">
      <condition field="destination_number" expression="^human_(.*)$">
        <action application="set" data="hangup_after_bridge=true"/>
        <action application="set" data="continue_on_fail=true"/>
        <!-- Missed Call Guard: bridge gives up after guard_seconds
             (default 20) and falls through to the guard extension. -->
        <!-- ${cond(...)} evaluates to the literal string "-ERR" when
             guard_seconds is unset (verified: `cond  > 0 ? : 20` -> -ERR),
             which silently became the call_timeout. The :-20 default keeps
             cond well-formed no matter who transferred here. -->
        <action application="set" data="call_timeout=${cond(${guard_seconds:-20} &gt; 0 ? ${guard_seconds:-20} : 20)}"/>
        <action application="record_session" data="/tmp/recordings/${uuid}.wav"/>
        <action application="bridge" data="${ring_group}"/>
        <!-- Nobody picked up in time -->
        <action application="transfer" data="missed_${caller_ani} XML heynikki"/>
      </condition>
    </extension>

    <!-- ── MISSED CALL GUARD ───────────────────────────────────
      Previously unreachable: this extension existed but nothing ever
      transferred to it, so the 20-second guard in the plan (and the
      missed_call_seconds value in platform_config) did nothing at all.
      inbound_human now falls through to it on ring-out.
      ============================================================ -->
    <extension name="missed_call_guard" continue="false">
      <!-- (.*) not (.+): a withheld/anonymous CLI makes caller_ani empty, so
           the transfer target is bare "missed_". With (.+) that failed to
           match and the call fell through to catch_all, which answers 404 on
           an already-answered channel. The webhook handles an empty caller. -->
      <condition field="destination_number" expression="^missed_(.*)$">
        <action application="answer"/>
        <action application="speak" data="flite|kal|Thank you for calling. All our representatives are busy. We will call you back shortly."/>
        <action application="system" data="curl -s -X POST http://127.0.0.1:4000/webhooks/freeswitch/missed-call -H 'Content-Type: application/json' -H 'X-Internal-Secret: ${INTERNAL_SECRET}' -d '{&quot;caller_number&quot;:&quot;$1&quot;,&quot;did_number&quot;:&quot;${did_number}&quot;}' &amp;"/>
        <action application="hangup"/>
      </condition>
    </extension>

    <!-- ── CLICK-TO-CALL (Human CRM) ─────────────────────────── -->
    <extension name="click_to_call_agent_leg" continue="false">
      <condition field="destination_number" expression="^ctc_agent_(\d+)$">
        <action application="set" data="hangup_after_bridge=true"/>
        <action application="answer"/>
        <action application="playback" data="tone_stream://%(2000,4000,440,480)"/>
        <action application="bridge" data="${ctc_customer_bridge}"/>
      </condition>
    </extension>

    <!-- ── OUTBOUND (Click-to-Call customer leg) ─────────────── -->
    <!-- Accepts out_ with any prefix form and hands Jio a single
         consistent format. Which format Jio WANTS on outbound is still
         unconfirmed — if calls fail with 404 from their SBC, try
         prefixing 0 or +91 in the bridge string below. -->
    <extension name="outbound_to_customer" continue="false">
      <condition field="destination_number" expression="^out_(?:\+?91|0)?(\d{10})$">
        <action application="set" data="hangup_after_bridge=true"/>
        <action application="set" data="effective_caller_id_number=${outbound_cli}"/>
        <action application="set" data="effective_caller_id_name=HeyNikki"/>
        <action application="bridge"
          data="sofia/gateway/jio_primary/$1|sofia/gateway/vi_failover/$1"/>
      </condition>
    </extension>

    <!-- ── OUTBOUND AI CAMPAIGN CALLS ─────────────────────────
      The literal token "outbound" sits in the {did_number} position of
      the WS path; the pipeline treats that as a sentinel and reads
      campaign context from the campaign_id query param instead.
      ============================================================ -->
    <extension name="outbound_campaign" continue="false">
      <condition field="destination_number" expression="^camp_(?:\+?91|0)?(\d{10})$">
        <action application="set" data="hangup_after_bridge=true"/>
        <action application="set" data="effective_caller_id_number=${outbound_cli}"/>
        <action application="answer"/>
        <!-- <action application="playback" data="/etc/freeswitch/sounds/trai_disclosure.wav"/> -->
        <!-- Same API-not-application fix as inbound_sip_ai above. -->
        <action application="set" data="stream_result=${uuid_audio_stream(${uuid} start ws://127.0.0.1:8000/ws/freeswitch/outbound/$1/${uuid}?campaign_id=${campaign_id} mono 8000)}"/>
        <action application="park"/>
      </condition>
    </extension>

    <!-- ── INTERNAL / INVALID → REJECT ───────────────────────── -->
    <extension name="catch_all">
      <condition field="destination_number" expression="^(.*)$">
        <action application="respond" data="404"/>
      </condition>
    </extension>

  </context>
</include>
